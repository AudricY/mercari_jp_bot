{
  "name": "mercari-jp-bot",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "description": "Mercari JP monitoring platform rewritten in Node.js/TypeScript",
  "dependencies": {
    "@mercari-bot/core": "workspace:*",
    "@mercari-bot/db": "workspace:*",
    "@prisma/client": "^6.19.2",
    "yaml": "^2.7.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm -r --if-present run dev",
    "start": "pnpm -r --if-present run start",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "db:generate": "PRISMA_GENERATE_SKIP_AUTOINSTALL=1 prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "probe:mercari-rate": "tsx scripts/mercari-rate-probe.ts"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "prisma": "^6.3.1",
    "telegram": "^2.26.22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
