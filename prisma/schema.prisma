generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Keyword {
  id           String                  @id @default(uuid())
  name         String                  @unique
  enabled      Boolean                 @default(true)
  terms        Json
  filters      Json
  intervalSec  Int                     @default(60) @map("interval_sec")
  topicName    String?                 @map("topic_name")
  topicId      String?                 @map("topic_id")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  topic        TelegramTopic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  listings     Listing[]
  seen         SeenListing[]
  scanRuns     ScanRun[]
  notifications Notification[]
  dailyCounts  DailyKeywordCount[]
  marketStats  DailyKeywordMarketStat[]

  @@map("keywords")
}

model TelegramTopic {
  id        String   @id @default(uuid())
  chatId    String   @map("chat_id")
  topicName String   @map("topic_name")
  threadId  Int      @map("thread_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  keywords  Keyword[]

  @@unique([chatId, topicName])
  @@map("telegram_topics")
}

model Listing {
  id              String         @id @default(uuid())
  sourceListingId String?        @map("source_listing_id")
  title           String
  url             String         @unique
  imageUrl        String         @map("image_url")
  currency        String
  numericPrice    Decimal        @map("numeric_price")
  rawPriceDisplay String         @map("raw_price_display")
  scrapedAt       DateTime       @map("scraped_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  rawJson         String?        @map("raw_json")
  rawDetailJson   String?        @map("raw_detail_json")
  keywordId       String?        @map("keyword_id")
  itemId          String?        @map("item_id")
  itemMatchStatus String?        @map("item_match_status")
  itemSubfamily   String?        @map("item_subfamily")
  keyword         Keyword?       @relation(fields: [keywordId], references: [id], onDelete: SetNull)
  item            Item?          @relation(fields: [itemId], references: [id], onDelete: SetNull)

  notifications   Notification[]

  @@index([keywordId, scrapedAt])
  @@index([itemId, scrapedAt])
  @@map("listings")
}

model Item {
  id             String                @id @default(uuid())
  slug           String                @unique
  displayName    String                @map("display_name")
  kind           String
  platform       String
  series         String?
  targetBuyPrice Decimal?              @map("target_buy_price")
  enabled        Boolean               @default(true)
  matchers       Json
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  listings       Listing[]
  marketStats    DailyItemMarketStat[]

  @@map("items")
}

model SeenListing {
  id         String   @id @default(uuid())
  dedupeKey  String   @unique @map("dedupe_key")
  listingId  String   @map("listing_id")
  keywordId  String   @map("keyword_id")
  lastPrice  Decimal  @map("last_price")
  firstSeenAt DateTime @map("first_seen_at")
  lastSeenAt DateTime @map("last_seen_at")

  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId])
  @@map("seen_listings")
}

model ScanRun {
  id          String       @id @default(uuid())
  keywordId   String       @map("keyword_id")
  keyword     Keyword      @relation(fields: [keywordId], references: [id], onDelete: Cascade)
  startedAt   DateTime     @default(now()) @map("started_at")
  finishedAt  DateTime?    @map("finished_at")
  status      String       @default("running")
  itemsFound  Int          @default(0) @map("items_found")
  itemsNew    Int          @default(0) @map("items_new")
  termsAttempted Int       @default(0) @map("terms_attempted")
  termsSucceeded Int       @default(0) @map("terms_succeeded")
  termsRateLimited Int     @default(0) @map("terms_rate_limited")
  termsFailed Int          @default(0) @map("terms_failed")
  errorCode   String?      @map("error_code")
  errorMessage String?     @map("error_message")
  terms       ScanRunTerm[]

  @@index([keywordId, startedAt])
  @@map("scan_runs")
}

model ScanRunTerm {
  id           String   @id @default(uuid())
  scanRunId    String   @map("scan_run_id")
  term         String
  status       String
  statusCode   Int?     @map("status_code")
  itemsFound   Int      @default(0) @map("items_found")
  itemsNew     Int      @default(0) @map("items_new")
  durationMs   Int      @default(0) @map("duration_ms")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")

  scanRun      ScanRun  @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  @@index([scanRunId])
  @@index([status])
  @@map("scan_run_terms")
}

model Notification {
  id                String             @id @default(uuid())
  listingId          String             @map("listing_id")
  keywordId          String             @map("keyword_id")
  channel            String
  status             String             @default("pending")
  attemptCount       Int                @default(0) @map("attempt_count")
  lastError          String?            @map("last_error")
  providerMessageId  String?            @map("provider_message_id")
  sentAt             DateTime?          @map("sent_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  keyword            Keyword            @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([keywordId, channel, status])
  @@map("notifications")
}

model DailyKeywordCount {
  dateUtc    DateTime @map("date_utc")
  keywordId  String   @map("keyword_id")
  sentCount  Int      @default(0) @map("sent_count")

  keyword    Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([dateUtc, keywordId])
  @@map("daily_keyword_counts")
}

model DailyKeywordMarketStat {
  dateUtc         DateTime @map("date_utc")
  keywordId       String   @map("keyword_id")
  listingCount    Int      @map("listing_count")
  minPrice        Decimal  @map("min_price")
  medianPrice     Decimal  @map("median_price")
  maxPrice        Decimal  @map("max_price")
  latestScrapedAt DateTime @map("latest_scraped_at")

  keyword         Keyword  @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([dateUtc, keywordId])
  @@map("daily_keyword_market_stats")
}

model MarketCategory {
  id                  Int       @id // Mercari ntiers leaf category id
  label               String
  platform            String
  kind                String // software | console | accessory | other
  enabled             Boolean   @default(true)
  snapshotIntervalSec Int?      @map("snapshot_interval_sec")
  soldSweepIntervalSec Int?     @map("sold_sweep_interval_sec")
  newSweepIntervalSec Int?      @map("new_sweep_interval_sec")
  newCursorCreatedSec Int?      @map("new_cursor_created_sec")
  lastSnapshotAt      DateTime? @map("last_snapshot_at")
  lastSoldSweepAt     DateTime? @map("last_sold_sweep_at")
  lastNewSweepAt      DateTime? @map("last_new_sweep_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  listings   MarketListing[]
  dailyStats DailyCategoryMarketStat[]

  @@map("market_categories")
}

model MarketListing {
  id               String    @id @default(uuid())
  mercariId        String    @unique @map("mercari_id")
  categoryId       Int       @map("category_id")
  title            String
  price            Int
  status           String // on_sale | trading | sold_out | gone
  conditionId      Int?      @map("condition_id")
  sellerId         String?   @map("seller_id")
  shippingPayerId  Int?      @map("shipping_payer_id")
  thumbnailUrl     String?   @map("thumbnail_url")
  mercariCreatedSec Int      @map("mercari_created_sec")
  mercariUpdatedSec Int      @map("mercari_updated_sec")
  soldPrice        Int?      @map("sold_price")
  soldObservedAt   DateTime? @map("sold_observed_at")
  firstSeenAt      DateTime  @map("first_seen_at")
  lastSeenAt       DateTime  @map("last_seen_at")

  category MarketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId, status, price])
  @@index([categoryId, mercariCreatedSec])
  @@index([categoryId, soldObservedAt])
  @@index([status, lastSeenAt])
  @@map("market_listings")
}

model DailyCategoryMarketStat {
  dateUtc           DateTime @map("date_utc")
  categoryId        Int      @map("category_id")
  onSaleCount       Int      @map("on_sale_count")
  newListingCount   Int      @map("new_listing_count")
  soldCount         Int      @map("sold_count")
  askingMinPrice    Decimal? @map("asking_min_price")
  askingMedianPrice Decimal? @map("asking_median_price")
  askingP25Price    Decimal? @map("asking_p25_price")
  askingP75Price    Decimal? @map("asking_p75_price")
  soldMinPrice      Decimal? @map("sold_min_price")
  soldMedianPrice   Decimal? @map("sold_median_price")
  soldP25Price      Decimal? @map("sold_p25_price")
  soldP75Price      Decimal? @map("sold_p75_price")
  soldMaxPrice      Decimal? @map("sold_max_price")

  category MarketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([dateUtc, categoryId])
  @@map("daily_category_market_stats")
}

model DailyItemMarketStat {
  dateUtc         DateTime @map("date_utc")
  itemId          String   @map("item_id")
  listingCount    Int      @map("listing_count")
  minPrice        Decimal  @map("min_price")
  medianPrice     Decimal  @map("median_price")
  maxPrice        Decimal  @map("max_price")
  latestScrapedAt DateTime @map("latest_scraped_at")

  item            Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([dateUtc, itemId])
  @@map("daily_item_market_stats")
}
