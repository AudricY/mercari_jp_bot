NODE_ENV=development
LOG_LEVEL=info
PORT=3000
ADMIN_TOKEN=change-me
ADMIN_ALLOWED_IPS=127.0.0.1,::1
DATABASE_URL=file:./data/mercari.db
TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_CHAT_ID=change-me
ANALYTICS_AUTH_USER=analytics
ANALYTICS_AUTH_PASSWORD=change-me
ANALYTICS_SESSION_PASSWORD=change-me-change-me-change-me-1234
TELEGRAM_MIN_DELAY_MS=1200
TELEGRAM_MAX_RETRIES=3
TELEGRAM_BACKOFF_FACTOR=2
SENTRY_DSN=
SCRAPE_CONCURRENCY=2
SCRAPE_HTTP_TIMEOUT_MS=15000
SCRAPE_MAX_ITEMS_PER_TERM=100
SCRAPE_SEARCH_MIN_DELAY_MS=1250
SCRAPE_DETAIL_ENABLED=true
SCRAPE_DETAIL_DELAY_MS=500
SCRAPE_DETAIL_MIN_DELAY_MS=3000
SCRAPE_RATE_LIMIT_COOLDOWN_MS=90000
SCHEDULER_TICK_SECONDS=30

# Market collection (comprehensive category scans; see docs/workflows/market-collection.md)
MARKET_SCAN_ENABLED=true
MARKET_SCAN_TICK_SECONDS=60
MARKET_SCAN_PAGE_SIZE=120
MARKET_SCAN_MAX_PAGES_PER_JOB=200
MARKET_SCAN_FAILURE_BACKOFF_SEC=900

# eBay collection (official Browse API; see docs/workflows/ebay-collection.md)
# Disabled until you set developer credentials from https://developer.ebay.com
EBAY_SCAN_ENABLED=false
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENVIRONMENT=production
EBAY_SCAN_TICK_SECONDS=60
EBAY_SCAN_PAGE_SIZE=200
EBAY_SCAN_MAX_PAGES_PER_JOB=50
EBAY_SCAN_FAILURE_BACKOFF_SEC=900
EBAY_SEARCH_MIN_DELAY_MS=1000
EBAY_RATE_LIMIT_COOLDOWN_MS=90000

# Arbitrage (Mercari JP -> eBay US; see docs/workflows/arbitrage.md)
ARBITRAGE_ALERTS_ENABLED=false
ARBITRAGE_ALERT_CHECK_SECONDS=120
ARBITRAGE_ALERT_TOPIC_NAME=
ARBITRAGE_CACHE_TTL_SEC=300
# 0 = fetch live FX (frankfurter.app, cached 12h); set to pin a manual rate
ARBITRAGE_FX_JPY_PER_USD=0
DISPLAY_TIMEZONE=UTC
DAILY_SUMMARY_TIME=12:30
